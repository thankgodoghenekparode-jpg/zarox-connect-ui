# API base URL. When the backend runs locally (default port 4000), leave this
# empty so requests go to /api/v1 and are proxied by Vite to http://localhost:4000.
#
# To point directly at the deployed backend instead, set:
#   VITE_API_BASE_URL=https://zarox-connect-api.onrender.com/api/v1
#
VITE_API_BASE_URL=
